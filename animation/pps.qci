// by Starfelll、糯米饭团

// sacle_fix = 1.0 / $Scale
$DefineVariable scale_fix 1.0  // 模型缩放因子

$IF character == female_npc
	$RedefineVariable ref_model "alyx"							// female_npc与alyx保持一致
	$DefineVariable declare_sequences_qci "anims_female_npc.qci"
$ELIF character == female_pm
	$RedefineVariable ref_model "alyx"						// female_pm与alyx保持一致
	$DefineVariable declare_sequences_qci "anims_female_pm.qci"
$ELIF character == male_npc
	$RedefineVariable ref_model "male"						// male_npc与male保持一致
	$DefineVariable declare_sequences_qci "anims_male_npc.qci"
$ELIF character == male_pm
	$RedefineVariable ref_model "male"						// male_pm与male保持一致
	$DefineVariable declare_sequences_qci "anims_male_pm.qci"
$ELSE
	$RedefineVariable ref_model "alyx"	
	$DefineVariable declare_sequences_qci "anims_alyx.qci"
$endif

