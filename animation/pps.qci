$Animation "a_reference" $custom_model$ Pick BindPose {
    frame 0 0
    scale $scale_fix$
	// The root bone needs to swap x and y.
	// \$DefineBone "(.*)" ".*" (.*?) (.*?) (.*?) .*
	// forceboneposrot "$1" pos $2 $3 $4
	$IF ref_model == male
		$DefineVariable ref_scale 1.00
		$DefineVariable ref_base male
		$reference_pos_male
	$ELIF ref_model == alyx
		$DefineVariable ref_scale 1.00
		$DefineVariable ref_base alyx
		$reference_pos_alyx
	$endif
}